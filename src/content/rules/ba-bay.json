      "when": { "npcId": "BA_BAY", "queueLength": "<=2", "ctxKhachMoiToi": "absent" },
      "say": ["Đào bây giờ mặt đẹp thiệt, mà hát tới câu vọng cổ là hụt hơi. Cô nói thiệt đó."] },
    { "id": "bay.bye.waited", "concept": "FAREWELL",
