    "Customer.tier":        { "type": "enum", "values": ["RIVAL", "ACQUAINTANCE", "FRIEND"] },
    "Customer.mood":        { "type": "ordinal", "values": ["CALM", "CHECKING", "ANNOYED"] },
    "Customer.visitCount":  { "type": "number", "min": 0 },
