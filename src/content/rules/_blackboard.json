    "Session.waitedSec":    { "type": "number", "min": 0 },
    "Session.defect":       { "type": "string" },
    "World.dayIndex":       { "type": "number", "min": 1, "max": 40 },
    "World.band":           { "type": "ordinal", "values": ["PRE_OPEN", "PEAK", "MID", "LULL"] },
    "World.weather":        { "type": "enum", "values": ["NANG", "MUA", "AM_U"] }
  },
  "signature": {
