{
  "_note": "Dì Liên — gánh tàu hũ đi ngang hẻm. ĐỒNG NGHIỆP, ngang hàng, không phải người để thương hại.",
  "rules": [
    {"id": "sau.dropped_food", "concept": "NOTICE_EVENT", "when": {"npcId": "BA_SAU", "eventId": "DROPPED_FOOD", "obsState": ">=NOTICED", "ctxBarkT1_DROP": "absent"}, "applycontext": {"ctxBarkT1_DROP": {"value": 1, "duration": 90}}, "say": ["Rớt rồi con ơi. Thôi bỏ, bán đồ ăn mà."]},
    {"id": "sau.dirty_hands", "concept": "NOTICE_EVENT", "when": {"npcId": "BA_SAU", "eventId": "DIRTY_HANDS", "obsState": ">=NOTICED", "ctxBarkT1_TAY": "absent"}, "applycontext": {"ctxBarkT1_TAY": {"value": 1, "duration": 90}}, "say": ["Tui bán tàu hũ cũng vậy à. Mà thôi, lau cái đi con."]},
    {"id": "sau.burnt_or_cold", "concept": "NOTICE_EVENT", "when": {"npcId": "BA_SAU", "eventId": "BURNT_OR_COLD", "eventBurnt": true, "obsState": ">=NOTICED", "ctxBarkT1_KHET": "absent"}, "applycontext": {"ctxBarkT1_KHET": {"value": 1, "duration": 90}}, "say": ["Cháy rồi con. Để đó tui ăn cho, đừng bỏ uổng."]},
    {"id": "sau.cold", "concept": "NOTICE_EVENT", "when": {"npcId": "BA_SAU", "eventId": "BURNT_OR_COLD", "eventBurnt": false, "obsState": ">=NOTICED", "ctxBarkT1_NGUOI": "absent"}, "applycontext": {"ctxBarkT1_NGUOI": {"value": 1, "duration": 90}}, "say": ["Nguội rồi nè con. Thôi kệ, tui ăn cũng được."]},
    {"id": "sau.flourish", "concept": "NOTICE_EVENT", "when": {"npcId": "BA_SAU", "eventId": "FLOURISH", "obsState": ">=NOTICED"}, "say": ["Tay nghề lên rồi con ơi."], "cooldown": 300},
    {"id": "sau.wait.confirmed", "concept": "NOTICE_EVENT", "when": {"npcId": "BA_SAU", "eventId": "MADE_THEM_WAIT", "obsState": "CONFIRMED"}, "say": ["Kệ con, tui ngồi đây nghỉ cái chân."]},
    {"id": "sau.del.seen", "concept": "DELIVERY", "when": {"npcId": "BA_SAU", "defectCount": ">=1", "defectWasSeen": true}, "say": ["Con bỏ thiếu kìa."]},
    {"id": "sau.del.found", "concept": "DELIVERY", "when": {"npcId": "BA_SAU", "defectCount": ">=1", "defectWasSeen": false}, "say": ["Thôi kệ, ăn cũng được."]},
    {"id": "sau.del.toomuch", "concept": "DELIVERY", "when": {"npcId": "BA_SAU", "defectCount": 0, "freeExtraTooMuch": true}, "say": ["Con cho nhiều quá. Mai tui đổi cho con chén tàu hũ."]},
    {"id": "sau.tea", "concept": "INTERACT", "when": {"npcId": "BA_SAU", "interaction": "TEA"}, "say": ["Trời, người bán hàng rong mà đi rót nước cho người bán hàng rong. Ngộ ha."]},
    {"id": "sau.chan", "concept": "SMALLTALK", "when": {"npcId": "BA_SAU", "queueLength": "<=2"}, "say": ["Cái chân tui dạo này nhức. Gánh từ đầu hẻm vô tới đây là muốn ngồi."], "norepeat": true, "odds": 50}
  ]
}
